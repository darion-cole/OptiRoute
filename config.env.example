# OptiRoute - installer settings
#
# Copy this file to config.env, fill it in, then run:  sh install.sh
# Lines starting with # are comments. Keep values in single quotes.

# ---------------------------------------------------------------------------
# Network ports
# ---------------------------------------------------------------------------
# Run `ls /sys/class/net` on the router to see your port names.
# WAN_IF = the port cabled to your modem / ONT.
# LAN_IF = the port cabled to your switch, access point or PC.
WAN_IF='eth0'
LAN_IF='eth1'

# The router's LAN address. Use your old router's address (often 192.168.1.1)
# so DHCP reservations and bookmarks keep working.
LAN_IP='192.168.1.1'
LAN_NETMASK='255.255.255.0'

# WAN type: 'dhcp' covers most cable and fiber connections.
# Use 'pppoe' only if your ISP gave you a PPPoE username and password.
WAN_PROTO='dhcp'
PPPOE_USERNAME=''
PPPOE_PASSWORD=''

# 1 = rewrite LAN/WAN at the end of the install (takes effect on reboot).
# 0 = leave the network config alone (useful if you already set it up).
APPLY_NETWORK='1'

# ---------------------------------------------------------------------------
# Bufferbloat shaping (qosmate)
# ---------------------------------------------------------------------------
# Measure your real speed first (see docs/TUNING.md), then enter ~90% of the
# LOWEST result you saw, in kilobits per second.
#   Example: lowest download 411 Mbps -> 411000 * 0.9 = 370000
DOWN_KBPS='370000'
UP_KBPS='485000'

# Overhead preset: 'ethernet' for fiber and most others, 'docsis' for cable.
LINK_PRESET='ethernet'

# Queueing discipline: 'hfsc' (gaming-focused, recommended) or 'cake'.
ROOT_QDISC='hfsc'

# ---------------------------------------------------------------------------
# Gaming devices
# ---------------------------------------------------------------------------
# IP addresses of gaming PCs / consoles, separated by spaces.
# Their UDP game traffic gets top priority (DSCP CS5).
GAMING_IPS='192.168.1.50'

# Optional: MAC addresses in the SAME ORDER as GAMING_IPS, so each device is
# reserved its IP. Leave empty to skip. Find a MAC with `cat /tmp/dhcp.leases`.
GAMING_MACS=''

# ---------------------------------------------------------------------------
# Optional features (1 = on, 0 = off)
# ---------------------------------------------------------------------------
ENABLE_QOSMATE='1'

# Geomate: geo-filter game servers (Call of Duty preset). Starts in monitor
# mode so nothing is blocked until you draw a region in the web UI.
ENABLE_GEOMATE='1'
# Source port the game uses on your device (3074 for Call of Duty).
GEOMATE_COD_PORT='3074'

# AdGuard Home network-wide ad blocking.
# NOTE: after install you MUST finish the setup wizard at http://LAN_IP:3000
# or DNS will not work for your devices. See docs/ADGUARD.md.
ENABLE_ADGUARD='1'

# UPnP for Open NAT, locked to the gaming devices above (secure mode).
ENABLE_UPNP='1'

# Low-latency CPU + NIC tuning (performance governor, shallow C-states only,
# interrupt coalescing off). Costs a few watts. See docs/TUNING.md.
ENABLE_LOWLATENCY='1'

# Extra packages to install, space separated (optional).
# USB Ethernet adapters need a driver; these two cover most of them.
EXTRA_PACKAGES='kmod-usb-net-rtl8152 kmod-usb-net-asix-ax88179'

# Set to '1' to skip the "type yes to continue" prompt.
ASSUME_YES='0'
